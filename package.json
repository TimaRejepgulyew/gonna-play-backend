{
  "name": "gonna-play-backend",
  "version": "1.0.0",
  "description": "gonna play app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts",
    "lint": "eslint --ext .ts src/",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "prisma:db:push": "prisma db push",
    "prisma:db:seed": "tsx prisma/seeds/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "postman:spec": "curl -s ${BASE_URL:-http://localhost:3000}/docs/json -o postman/specs/openapi.json",
    "postman:collection": "openapi2postmanv2 -s postman/specs/openapi.json -o postman/collections/gonna-play.postman_collection.json -p -O folderStrategy=Paths,requestParametersResolution=Example,optimizeConversion=false",
    "postman:generate": "npm run postman:spec && npm run postman:collection && npm run postman:smoke",
    "postman:smoke": "node scripts/postman-smoke.mjs",
    "postman:test": "newman run postman/collections/gonna-play.smoke.postman_collection.json -e postman/environments/local.postman_environment.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimaRejepgulyew/gonna-play-backend.git"
  },
  "keywords": [
    "app",
    "to",
    "play",
    "football"
  ],
  "author": "Timur Rejepguliev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TimaRejepgulyew/gonna-play-backend/issues"
  },
  "homepage": "https://github.com/TimaRejepgulyew/gonna-play-backend#readme",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/redis": "^8.0.0",
    "@fastify/swagger": "^9.5.1",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.11.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.33",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^3",
    "newman": "^6.2.2",
    "openapi-to-postmanv2": "^6.3.0",
    "prisma": "^6.7.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22.0.0"
  }
}
