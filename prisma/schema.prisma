generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id              Int      @id @default(autoincrement())
  avatar          String?
  birthDate       String?
  city            String?
  country         String?
  email           String?  @unique
  firstName       String?
  gender          String?
  isActive        Boolean? @default(true)
  isEmailVerified Boolean? @default(false)
  isPhoneVerified Boolean? @default(false)
  lastName        String?
  name            String?
  password        String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  identities AuthIdentity[]
  player     Player?
  userRoles  UserRole[]

  @@map("users")
}

model AuthIdentity {
  id                    Int           @id @default(autoincrement())
  userId                Int
  provider              AUTH_PROVIDER
  providerUserId        String
  email                 String?
  username              String?
  lastLoginAt           DateTime?
  // Долгоживущий refresh-токен провайдера, зашифрованный AES-256-GCM.
  // Заполняется только для APPLE и только ради отзыва доступа при удалении
  // аккаунта. Открытым текстом здесь не лежит ничего.
  refreshTokenEncrypted String?
  refreshTokenUpdatedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  // Инвариант «одна запись на провайдера у пользователя»: отвязка удаляет строки
  // пачкой и снесла бы дубликаты разом, а выбор refresh-токена Apple стал бы
  // произвольным. Проверка в сервисе идёт до вставки и гонку не закрывает.
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Player {
  id        Int              @id @default(autoincrement())
  name      String
  level     PLAYER_LEVEL?
  position  PLAYER_POSITION?
  status    PLAYER_STATUS?   @default(ACTIVE)
  userId    Int?             @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizedMatches    Match[]            @relation("MatchOrganizer")
  matchParticipations MatchParticipant[]
  ratingsGiven        PlayerRating[]     @relation("RatingsGiven")
  ratingsReceived     PlayerRating[]     @relation("RatingsReceived")

  @@map("players")
}

model Location {
  id           Int           @id @default(autoincrement())
  name         String
  address      String?
  city         String
  country      String?
  latitude     Float?
  longitude    Float?
  surfaceType  SURFACE_TYPE?
  capacity     Int?
  openingHours String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  fields Field[]

  @@index([city])
  @@map("locations")
}

model Field {
  id         Int           @id @default(autoincrement())
  locationId Int
  name       String
  format     MATCH_FORMAT
  surface    SURFACE_TYPE?
  width      Float?
  length     Float?
  isIndoor   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  matches  Match[]

  @@index([locationId])
  @@index([format])
  @@map("fields")
}

model Match {
  id              Int              @id @default(autoincrement())
  organizerId     Int
  fieldId         Int
  title           String
  startsAt        DateTime
  durationMin     Int              @default(60)
  format          MATCH_FORMAT
  minPlayers      Int
  maxPlayers      Int
  price           Decimal?         @db.Decimal(10, 2)
  currency        String?          @db.VarChar(3)
  visibility      MATCH_VISIBILITY @default(PUBLIC)
  status          MATCH_STATUS     @default(DRAFT)
  skillMin        PLAYER_LEVEL?
  skillMax        PLAYER_LEVEL?
  description     String?
  teamsBalancedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  organizer    Player             @relation("MatchOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  field        Field              @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  participants MatchParticipant[]
  ratings      PlayerRating[]

  @@index([organizerId])
  @@index([fieldId])
  @@index([status])
  @@index([format])
  @@index([skillMin])
  @@index([skillMax])
  @@index([startsAt])
  @@index([status, startsAt])
  @@map("matches")
}

model MatchParticipant {
  id            Int                @id @default(autoincrement())
  matchId       Int
  playerId      Int
  position      PLAYER_POSITION?
  team          TEAM_SIDE?
  status        PARTICIPANT_STATUS
  paymentStatus PAYMENT_STATUS     @default(UNPAID)
  joinedAt      DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([matchId, status, joinedAt])
  @@map("match_participants")
}

model PlayerRating {
  id        Int      @id @default(autoincrement())
  matchId   Int
  raterId   Int
  ratedId   Int
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater Player @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rated Player @relation("RatingsReceived", fields: [ratedId], references: [id], onDelete: Cascade)

  @@unique([matchId, raterId, ratedId])
  @@index([ratedId])
  @@index([raterId])
  @@index([matchId])
  @@map("player_ratings")
}

enum AUTH_PROVIDER {
  GOOGLE   @map("google")
  APPLE    @map("apple")
  TELEGRAM @map("telegram")
}

enum PLAYER_LEVEL {
  JUNIOR @map("junior")
  MIDDLE @map("middle")
  SENIOR @map("senior")
  LEGEND @map("legend")
}

enum PLAYER_POSITION {
  GOALKEEPER @map("goalkeeper")
  DEFENDER   @map("defender")
  MIDFIELDER @map("midfielder")
  FORWARD    @map("forward")
}

enum PLAYER_STATUS {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum MATCH_FORMAT {
  FIVE   @map("5x5")
  SEVEN  @map("7x7")
  ELEVEN @map("11x11")
}

enum MATCH_STATUS {
  DRAFT       @map("draft")
  OPEN        @map("open")
  FULL        @map("full")
  CONFIRMED   @map("confirmed")
  IN_PROGRESS @map("in_progress")
  FINISHED    @map("finished")
  CANCELLED   @map("cancelled")
}

enum MATCH_VISIBILITY {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

enum PARTICIPANT_STATUS {
  REGISTERED @map("registered")
  WAITLISTED @map("waitlisted")
  CONFIRMED  @map("confirmed")
  CHECKED_IN @map("checked_in")
  NO_SHOW    @map("no_show")
  CANCELLED  @map("cancelled")
}

enum TEAM_SIDE {
  A @map("a")
  B @map("b")
}

enum PAYMENT_STATUS {
  UNPAID @map("unpaid")
  PAID   @map("paid")
  WAIVED @map("waived")
}

enum SURFACE_TYPE {
  NATURAL_GRASS    @map("natural_grass")
  ARTIFICIAL_GRASS @map("artificial_grass")
  FUTSAL           @map("futsal")
  CONCRETE         @map("concrete")
  DIRT             @map("dirt")
}
