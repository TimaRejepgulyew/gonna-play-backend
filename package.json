{
  "name": "football-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:prod": "node build/index.js",
    "build": "tsc",
    "migrate": "ts-node src/migrate.ts",
    "migrate:create": "node scripts/create-migration.js",
    "docker:start": "./scripts/start-dev.sh",
    "docker:stop": "./scripts/stop-dev.sh",
    "docker:restart": "npm run docker:stop && npm run docker:start",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --apply ./src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "./scripts/run-api-tests.sh",
    "test:api:local": "./scripts/run-api-tests.sh local",
    "test:api:docker": "./scripts/run-api-tests.sh docker",
    "test:api:staging": "./scripts/run-api-tests.sh staging",
    "test:api:prod": "./scripts/run-api-tests.sh production",
    "sonar": "node src/sonar.js",
    "sonar:coverage": "npm run test:coverage && npm run sonar"
  },
  "dependencies": {
    "@fastify/cors": "^8.3.0",
    "@fastify/jwt": "^7.2.1",
    "@fastify/postgres": "^5.2.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^1.10.1",
    "bcrypt": "^5.1.1",
    "dotenv-safe": "^8.2.0",
    "fastify": "^4.24.3",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.4.1",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "sonarqube-scanner": "^4.2.7",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
