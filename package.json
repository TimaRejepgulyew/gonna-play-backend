{
  "name": "gonna-play-backend",
  "version": "1.0.0",
  "description": "gonna play app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "npx tsx watch src/index.ts",
    "lint": "biome ci . && node scripts/check-comments.mjs",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:report": "node scripts/check-comments.mjs --report",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "prisma:db:push": "prisma db push",
    "prisma:db:seed": "tsx prisma/seeds/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "postman:spec": "curl -s ${BASE_URL:-http://localhost:3000}/docs/json -o postman/specs/openapi.json",
    "postman:collection": "openapi2postmanv2 -s postman/specs/openapi.json -o postman/collections/gonna-play.postman_collection.json -p -O folderStrategy=Paths,requestParametersResolution=Example,optimizeConversion=false",
    "postman:generate": "npm run postman:spec && npm run postman:collection && npm run postman:smoke",
    "postman:smoke": "node scripts/postman-smoke.mjs",
    "postman:test": "npm run postman:collection && npm run postman:smoke && newman run postman/collections/gonna-play.smoke.postman_collection.json --env-var baseUrl=${BASE_URL:-http://localhost:3000}",
    "prepare": "[ -e .git ] && git config core.hooksPath .githooks || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimaRejepgulyew/gonna-play-backend.git"
  },
  "keywords": [
    "app",
    "to",
    "play",
    "football"
  ],
  "author": "Timur Rejepguliev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TimaRejepgulyew/gonna-play-backend/issues"
  },
  "homepage": "https://github.com/TimaRejepgulyew/gonna-play-backend#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/redis": "^8.0.0",
    "@fastify/swagger": "^9.8.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4",
    "newman": "^6.2.2",
    "openapi-to-postmanv2": "^6.3.1",
    "prisma": "^7.9.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.4",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4"
  },
  "resolutions": {
    "ajv/fast-uri": "^3.1.4",
    "json-schema-resolver/fast-uri": "^3.1.4",
    "fast-json-stringify/fast-uri": "^4.1.1",
    "find-my-way": "^9.7.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=24.0.0"
  }
}
