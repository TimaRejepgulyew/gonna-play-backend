#!/bin/sh
# Гейт коммита: тот же источник правды, что и `npm run lint`, но по одним лишь
# staged-файлам, чтобы не платить за весь репозиторий на каждом коммите.
# Подключается командой `git config core.hooksPath .githooks`.
# Аварийный выход — штатный `git commit --no-verify`.
set -e

# Список путей идёт через `-z` и файл, а не через подстановку `$files`: без
# кавычек путь с пробелом распадался на фрагменты, а не-ASCII имя git по
# умолчанию (`core.quotePath`) отдавал в кавычках с экранированием. Оба
# инструмента такой файл молча пропускали — у Biome стоит
# `--no-errors-on-unmatched`, а скрипт считает фрагмент путём вне области, —
# то есть файл уходил в коммит непроверенным. `-z` отключает и разбиение по
# переводу строки, и цитирование, `xargs -0` передаёт пути как есть.
staged_list=$(mktemp "${TMPDIR:-/tmp}/pre-commit-staged.XXXXXX")
trap 'rm -f "$staged_list"' EXIT HUP INT TERM

git diff --cached -z --name-only --diff-filter=ACMR \
  -- '*.ts' '*.mjs' '*.js' '*.json' '*.jsonc' >"$staged_list"

# Ранний выход обязан быть полной формой `if`, а не сокращением
# `[ ! -s "$staged_list" ] && exit 0`: под `set -e` такое сокращение при
# НЕПУСТОМ списке возвращает ненулевой статус последней команды и роняет хук до
# первой проверки, то есть коммит отклонялся бы всегда.
if [ ! -s "$staged_list" ]; then
  exit 0
fi

# У Biome 2.5.5 есть флаг `--staged`, но список путей всё равно нужен второй
# проверке, а два независимых способа отбора файлов разошлись бы между собой,
# поэтому источник списка здесь один — git выше.
xargs -0 npx biome check --no-errors-on-unmatched --files-ignore-unknown=true <"$staged_list"

xargs -0 node scripts/check-comments.mjs --files <"$staged_list"
